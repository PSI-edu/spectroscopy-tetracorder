# case.veg.type//vegetation.type13.fd.gif   c_red           #  Saltbrush ANP92-31A                    y 7518
# case.veg.type//vegetation.type14.fd.gif   c_armygreen     #  LeafySpurge Spurge-A1-Jun98            y 7272
