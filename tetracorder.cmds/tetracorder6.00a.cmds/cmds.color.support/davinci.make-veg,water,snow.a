#!/usr/bin/env -S davinci -q -f  
####!/usr/local/bin/davinci -q -f

###########################  was:  #!/usr/local/bin/davinci -q -f



# command line:
# prog    gray_base_image  prefix-file-name   [dual|nodual]

prog="davinci.make-veg,water,snow.a"     # CHANGE THIS if program name changes

####################  Begin static: no need to change inything in this section ################

if ($argc < 2) {

        printf("Insufficient input\n")
        printf("%s input_gray_image  outputcolorimage\n", prog)
        printf("exit 1\n")
        exit(1)
}


dual    = 1     # default color + gray image 
dualmax = 2000  # no dual if width is greater than this

if ($argc >= 3) {

	if ( "$3" == "nodual" ) {
		dual = 0
	}
	if ( "$3" == "dual" ) {
		dual = 1
		dualmax = 999999 
	}

	printf ("\n\n\n\n%s   %s   %s   %s\n\n\n", prog, $1, $2, $3)
} else {

	printf ("\n\n\n\n%s   %s   %s\n\n\n", prog, $1, $2)
}


# read base gray image

gbase=read(filename=$1)
if (HasValue(gbase) ==0) {                   # check that read worked
      printf ("read ERROR on file: %s\n",$1)
      printf ("^GEXIT 1\n")
      exit(1)
}

# execute this program in the same directory asthe source code below
source ("cmds.color.support/davinci.master.colors")

# available colors:

# 22 available colors:
# c_red      c_green          c_blue       c_yellow        c_magenta       c_cyan      c_armygreen  
# c_salmon   c_flesh          c_orange     c_deeppink      c_yellowgreen   c_lavender  c_bluegreen
# c_skyblue  c_paleseagreen   c_white      c_redpink       c_gold          c_mudyellow c_lightpink
# c_purple

# a purple/magenta to red 12 spectral color sequence:
#
# c_magenta c_purple c_blue c_skyblue c_cyan c_green c_armygreen c_yellow c_gold c_salmon c_orange c_red

###########################################################################

define read_an_image(1,1) {

        # read a gray-scale image and convert to 3-bands

        afile = $1   # file to read
        printf ("reading file %s\n", afile)
        aaa=read(filename=afile)
        if (HasValue(aaa) ==0) {  # check that read worked
                printf ("read ERROR on file: %s\n",afile)
                printf ("setting to zero\n")
                aaa=0
        }
	aaa = aaa[,,1]             # make sure the image is one band
        qqq = cat(aaa,aaa,axis=z)  # make into 2-band image
        aaa = cat(aaa,qqq,axis=z)  # make into 3-band image

        return (aaa)

}  # end define

#        make the xcolor image
a      = read_an_image($1)
xcolor = float(a*0)
xdim   = dim(xcolor)


###################   begin custom section ##########################################

# first image:

# available colors:
# c_red     c_green          c_blue       c_yellow        c_magenta       c_cyan          c_armygreen  
# c_salmon  c_flesh          c_orange     c_deeppink      c_yellowgreen   c_lavender  
# c_skyblue c_paleseagreen   c_white      c_redpink       c_gold          c_mudyellow     c_lightpink

# group.1um/water.high.chlorophyll.fd.gif      c_blue
# group.1um/water.low.chlorophyll.fd.gif       c_blue

# group.1um/water+mont0.5gpl.fd.gif            c_yellow
# group.1um/water+mont1.67gpl.fd.gif           c_yellow
# group.1um/water+mont5.01gpl.fd.gif           c_yellow

# group.1um/water+mont16.5gpl.fd.gif           c_mudyellow
# group.1um/water+mont50gpl.fd.gif             c_mudyellow

# group.1um/water+mont100gpl.fd.gif            c_orange
# group.1um/water+mont300gpl.fd.gif            c_orange

# group.1um/water.red.algae.fd.gif             c_red

# group.1um/water+mont100gpl+0.5veg.fd.gif     c_paleseagreen
# group.1um/water+mont50gpl+0.5veg.fd.gif      c_paleseagreen

# group.1um/snow.and.ice.fd.gif                c_white

# group.1um/snow.melting.1a.fd.gif             c_cyan
# group.1um/snow.melting.3.fd.gif              c_cyan
# group.1um/snow.melting.8.fd.gif              c_cyan

# group.1um/snow.slush.16.fd.gif               c_skyblue
# group.1um/snow.slush.9.fd.gif                c_skyblue

# group.1um/snow.melting9+0.5veg.fd.gif        c_yellowgreen
# group.1um/snow.melting16+0.5veg.fd.gif       c_yellowgreen
# group.1um/snow.melting1a+0.5veg.fd.gif       c_yellowgreen

# group.1um/vegetation1.fd.gif                 c_green
# group.1um/vegetation.dry+green.fd.gif        c_armygreen  

c= c_blue
a = read_an_image("group.1um/water.low.chlorophyll.fd.gif")    # blue
a = a+ read_an_image("group.1um/water.high.chlorophyll.fd.gif")  #  blue
a = a+ read_an_image("group.1um/water.high.chlorophyll2.fd.gif")  #  blue
a = a+ read_an_image("group.1um/water.low.chlorophyll-blue1.fd.gif")
a = a+ read_an_image("group.1um/water.turquoise-shallow.fd.gif")
a = a+ read_an_image("group.1um/water.low.chlorophyll-turquoise.fd.gif")

     xcolor= xcolor + a*( c /255.)
     a=0   # be sure array is cleared


c= c_yellow
a = read_an_image("group.1um/water+mont0.5gpl.fd.gif")           #  c_yellow
a = a+ read_an_image("group.1um/water+mont1.67gpl.fd.gif")       #  c_yellow
a = a+ read_an_image("group.1um/water+mont5.01gpl.fd.gif")       #  c_yellow
a = a+ read_an_image("group.1um/water-20C-10cm-path-model.fd.gif")

     xcolor= xcolor + a*( c /255.)
     a=0   # be sure array is cleared

c= c_mudyellow
a = read_an_image("group.1um/water+mont16.5gpl.fd.gif")          # c_mudyellow
a = a+ read_an_image("group.1um/water+mont50gpl.fd.gif")         # c_mudyellow
a = a+ read_an_image("group.1um/water-20C-10cm-path-model.fd.gif")
a = a+ read_an_image("group.1um/water-20C-30cm-path-model.fd.gif")
a = a+ read_an_image("group.1um/water-20C-100cm-path-model.fd.gif")

	xcolor= xcolor + a*( c /255.)
	=0   # be sure array is cleared

c= c_orange
a = a+ read_an_image("group.1um/water+mont100gpl.fd.gif")     # c_orange
a = a+ read_an_image("group.1um/water+mont300gpl.fd.gif")     # c_orange

     xcolor= xcolor + a*( c /255.)
     a=0   # be sure array is cleared


c= c_red
a = read_an_image("group.1um/water.red.algae.fd.gif")         #  red

     xcolor= xcolor + a*( c /255.)
     a=0   # be sure array is cleared


# group.1um/snow.and.ice.fd.gif                c_magenta    was  c_white
# group.1um/snow.melting.1a.fd.gif             c_cyan
# group.1um/snow.melting.3.fd.gif              c_cyan
# group.1um/snow.melting.8.fd.gif              c_cyan
# group.1um/snow.slush.16.fd.gif               c_skyblue
# group.1um/snow.slush.9.fd.gif                c_skyblue

c= c_magenta
a = read_an_image("group.1um/snow.and.ice-77k.fd.gif")                 #  c_magenta
a = a + read_an_image("group.1um/h2o-frost+ice-drops1-100k.fd.gif")    #  c_magenta
a = a + read_an_image("group.1um/h2o-frost+ice-drops3-100k.fd.gif")    #  c_magenta
a = a + read_an_image("group.1um/snow.and.ice-170k.fd.gif")            #  c_magenta
a = a + read_an_image("group.1um/snow.and.ice-148k.fd.gif")            #  c_magenta
a = a + read_an_image("group.1um/snow-ice-1mm-273k.fd.gif")            #  c_magenta
a = a + read_an_image("group.1um/snow-ice-3mm-273k.fd.gif")            #  c_magenta
a = a + read_an_image("group.1um/snow-ice-10mm-273k.fd.gif")            #  c_magenta

     xcolor= xcolor + a*( c /255.)
     a=0   # be sure array is cleared


c= c_cyan
a = read_an_image("group.1um/snow.melting.1a.fd.gif")                  #  c_cyan
a = a+ read_an_image("group.1um/snow.melting.3.fd.gif")                #  c_cyan
a = a+ read_an_image("group.1um/snow.melting.8.fd.gif")                #  c_cyan
a = a + read_an_image("group.1um/snow-ice-3mm+0.1water-273k.fd.gif")   #  c_cyan
a = a + read_an_image("group.1um/snow-ice-3mm+0.2water-273k.fd.gif")   #  c_cyan
a = a + read_an_image("group.1um/snow-ice-3mm+0.3water-273k.fd.gif")   #  c_cyan

     xcolor= xcolor + a*( c /255.)
     a=0   # be sure array is cleared



c= c_skyblue
a = read_an_image("group.1um/snow.slush.16.fd.gif")                    #  c_skyblue
a = a+ read_an_image("group.1um/snow.slush.9.fd.gif")                  #  c_skyblue
a = a + read_an_image("group.1um/snow-ice-10mm+0.3water-273k.fd.gif")  #  c_skyblue

     xcolor= xcolor + a*( c /255.)
     a=0   # be sure array is cleared


# group.1um/snow.melting9+0.5veg.fd.gif        c_yellowgreen
# group.1um/snow.melting16+0.5veg.fd.gif       c_yellowgreen
# group.1um/snow.melting1a+0.5veg.fd.gif       c_yellowgreen

c= c_paleseagreen
a = read_an_image("group.1um/snow.melting9+0.5veg.fd.gif")             #  c_paleseagreen
a = a+ read_an_image("group.1um/snow.melting16+0.5veg.fd.gif")         #  c_paleseagreen
a = a+ read_an_image("group.1um/snow.melting1a+0.5veg.fd.gif")         #  c_paleseagreen
a = a+ read_an_image("group.1um/water-20C-10cm-path+chlrph-g.fd.gif")  #  c_paleseagreen
a = a+ read_an_image("group.1um/water-20C-100cm-path+chlrph-g.fd.gif")  #  c_paleseagreen
a = a+ read_an_image("group.1um/water-20C-300cm-path+chlrph-g.fd.gif")  #  c_paleseagreen
a = a+ read_an_image("group.1um/water-20C-100cm-path+chlrph-a.fd.gif")  #  c_paleseagreen

     xcolor= xcolor + a*( c /255.)
     a=0   # be sure array is cleared


# group.1um/vegetation1.fd.gif                 c_green
# group.1um/vegetation.dry+green.fd.gif        c_armygreen  

c= c_green
a = read_an_image("group.1um/vegetation1.fd.gif")         #  c_green

     xcolor= xcolor + a*( c /255.)
     a=0   # be sure array is cleared


c= c_armygreen
a = read_an_image("group.1um/vegetation.dry+green.fd.gif")         #  c_armygreen

     xcolor= xcolor + a*( c /255.)
     a=0   # be sure array is cleared


# veg with muddy soil
# group.1um/water+mont100gpl+0.5veg.fd.gif     c_yellowgreen
# group.1um/water+mont50gpl+0.5veg.fd.gif      c_yellowgreen

c= c_yellowgreen
a = read_an_image("group.1um/water+mont100gpl+0.5veg.fd.gif")    # c_yellowgreen
a = a+ read_an_image("group.1um/water+mont50gpl+0.5veg.fd.gif")  # c_yellowgreen



########### end custom, no need to change anything below this line ###############################

if (HasValue(xcolor) ==0) {

        printf ("%s: xcolor has no value\n", prog)
        printf ("EXIT 1\n")
        exit(1)
}


xout=byte(xcolor+0.5)   # output color image, byte
xout = bip(xout)
xdim=dim(xout)
xdimx=xdim[1,,]      # color image width

fout=$2

foute="color.results-envi/" + fout

write (xout, filename=foute, type=vicar)


gbasedim=dim(gbase)
x=gbasedim[1,,]      # base image width

if (x > dualmax) {
        dual = 0
}

if ( dual == 1 ) {

        gbase = bip(gbase)
        xout = cat (xout, gbase, axis=x)
}


adim=dim(xout)
if ( adim[1,,] > 5 || adim[2,,] > 5 ) {
        printf ("writing %s\n", fout)
        write (xout, filename=fout, type=png)
} else {
        printf ("not writing %s\n", fout)
        printf ("    image size < 6 pixels\n")
}

