#!/bin/sh

if [ -z "$1" ]
then
	echo " "
	echo "Usage:"
	echo "cmds.geology/cmd.make-all.geologic.mineral.group.images   aname"
	echo " "
	echo "example:"
	echo "        cmds.geology/cmd.make-all.geologic.mineral.group.images cuprite95"
	echo " "
	echo "exit 1"
	exit 1
fi

#set -x

# file: geologic-origins/material-classification.txt
# \#  Material                       classification          group
# \#
# \#       11111111112222222222333333333344444444445555555555666666666677777777778
# \# 45678901234567890123456789012345678901234567890123456789012345678901234567890
# \#                            |--|                    |--|                    |
# zero                              zero                    zero
# acid_mine_drainage                mixture
# actinolite                        inosilicate             amphibole
# adularia                          tectosilicate           feldspar
# albite                            tectosilicate           feldspar


gclass="geologic-origins/material-classification.txt"

if [ -f "$gclass" ]
then
	echo "Found $gclass"
else

	echo "ERROR: not found: $gclass"
	echo "run this program from you main mapping directory"
	echo "exit 1"
	exit 1
fi

# make:
#        geologic-origins/material-mineral-group-categories.txt
#   and
#        geologic-origins/material-mineral-group-categories-count.txt

# count may look something like this:

cat $gclass | grep -v '^\\#' | grep -v '^zero' | cut -c 59-78 | \
		grep -v 'group='   |  sed -e 's/ *$//'  | sort | \
	uniq -c > geologic-origins/material-mineral-group-categories-count.txt

cat $gclass | grep -v '^\\#' | grep -v '^zero' | cut -c 59-78 | \
		grep -v 'group='   |sed -e 's/ *$//'  | sort -u > \
		geologic-origins/material-mineral-group-categories.txt

aname=$1

for i in `cat geologic-origins/material-mineral-group-categories.txt`
do
	echo " "
	echo " "

	echo "./cmds.geology/cmd.make-one.geologic.mineral.group.image $i geologic-groups/${aname}-${i} "
	./cmds.geology/cmd.make-one.geologic.mineral.group.image $i geologic-groups/${aname}-${i} 
done
