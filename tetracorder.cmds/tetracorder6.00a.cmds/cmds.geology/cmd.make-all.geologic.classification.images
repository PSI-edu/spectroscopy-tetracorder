#!/bin/sh

if [ -z "$1" ]
then
	echo " "
	echo "Usage:"
	echo "cmds.geology/cmd.make-all.geologic.classification.images   aname"
	echo " "
	echo "example:"
	echo "        cmds.geology/cmd.make-all.geologic.classification.images cuprite95"
	echo " "
	echo "exit 1"
	exit 1
fi

#set -x

gclass="geologic-origins/material-classification.txt"

if [ -f "$gclass" ]
then
	echo "Found $gclass"
else

	echo "ERROR: not found: $gclass"
	echo "run this program from you main mapping directory"
	echo "exit 1"
	exit 1
fi

# make:
#        geologic-origins/material-classification-categories.txt
#   and
#        geologic-origins/material-classification-categories-count.txt

# count may look something like this:
#      3 aliphatichydrocarbon
#      1 alkene_hydrocarbon
#      1 alkyne_hydrocarbon
#      5 aromatic_hydrocarbon
#     17 biogenic
#      5 borate
#     52 carbonate
#      1 cyclosilicate
#      1 element
#     17 generic_fe2+
#      3 generic_fe2+fe3+
#      1 generic_fe3+
#      1 glass
#      5 group=
#      1 halide
#     24 hydroxide
#     12 inosilicate
#      1 manmade
#      4 mixture
#     14 nesosilicate
#      4 nitrate
#      5 nitrile
#     13 organic
#     56 oxide
#      2 perchlorate
#    133 phyllosilicate
#      2 smectite
#      5 sorosilicate
#     71 sulfate
#      4 sulfide
#     12 tectosilicate

cat $gclass | grep -v '^\\#' | grep -v '^zero' | cut -c 35-54 | sed -e 's/ *$//'  | sort | uniq -c > geologic-origins/material-classification-categories-count.txt

cat $gclass | grep -v '^\\#' | grep -v '^zero' | cut -c 35-54 | sed -e 's/ *$//'  | sort -u > geologic-origins/material-classification-categories.txt

aname=$1

for i in `cat geologic-origins/material-classification-categories.txt`
do
	echo " "
	echo " "

	echo "./cmds.geology/cmd.make-one.geologic.classification.image $i geologic-classifications/${aname}-${i} "
	./cmds.geology/cmd.make-one.geologic.classification.image $i geologic-classifications/${aname}-${i} 
done
